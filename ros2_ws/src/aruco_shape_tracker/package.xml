<?xml version="1.0"?>
<package format="3">
  <name>aruco_shape_tracker</name>
  <version>0.1.0</version>
  <description>Base-relative ArUco shape-state extraction for the two deformable arms.</description>
  <maintainer email="maintainer@example.com">ROSAIA maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>ament_cmake_python</build_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>librealsense2</depend>

  <!-- Keep the Python reference implementation and geometry unit tests. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- pyrealsense2 is installed from Intel/pip on this workstation. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
